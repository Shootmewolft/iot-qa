# =============================================================================
# ThingSpeak QA - variables de entorno
# =============================================================================
# Copia este archivo a .env.local para desarrollo.
# En Vercel, definelas en Project Settings -> Environment Variables.
# NINGUNA de estas variables debe llevar el prefijo NEXT_PUBLIC_.
# =============================================================================

# --- Fase 2: acceso y sesion (OBLIGATORIAS) ---------------------------------

# Contrasena compartida que protege toda la aplicacion.
APP_PASSWORD=

# Clave HMAC para firmar los tokens de sesion. Minimo 32 caracteres.
# Generala con:  openssl rand -base64 48
SESSION_SECRET=

# Origen canonico del despliegue. Sirve para rechazar escrituras cross-site.
# Dejala VACIA en local (si no, se rompe http://localhost).
# En Vercel: https://tu-proyecto.vercel.app
APP_ORIGIN=

# --- Fase 3: lectura de ThingSpeak ------------------------------------------

# Base de la API. Solo cambiala si usas un proxy propio.
THINGSPEAK_BASE_URL=https://api.thingspeak.com

# ID numerico del canal. OBLIGATORIA.
# Canal del Grupo 4: 3474649
THINGSPEAK_CHANNEL_ID=

# Read API Key. OPCIONAL: solo hace falta si el canal es privado.
# El canal 3474649 es publico, asi que puede quedar vacia.
THINGSPEAK_READ_API_KEY=

# --- Fase 6: carga masiva (todavia sin usar) --------------------------------

# Write API Key del canal. Necesaria para el Bulk Write.
# La encuentras en ThingSpeak -> Channel -> API Keys.
THINGSPEAK_WRITE_API_KEY=

# --- Fase 8: mantenimiento (todavia sin usar) -------------------------------

# User API Key de la CUENTA, no del canal.
# ThingSpeak -> Account -> My Profile -> User API Key.
#
# CUIDADO: esta clave puede vaciar CUALQUIER canal de la cuenta, no solo el
# 3474649. Es la unica que permite el DELETE de feeds. Definela solo cuando
# vayas a usar las tareas de mantenimiento.
THINGSPEAK_USER_API_KEY=
