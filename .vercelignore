# Vercel does NOT reliably honour .gitignore for uploads. Without this file a
# local .env is packaged into the deployment and its values become the app's
# runtime configuration, silently bypassing the project's environment
# variables. Everything secret must be set with `vercel env add`.
.env
.env.*
!.env.example

# Never needed in a deployment.
e2e
test-results
playwright-report
blob-report
playwright
.next
node_modules
